<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 로그 경로 설정: 프로젝트 루트 하위의 .logs 폴더 -->
    <property name="LOG_PATH" value="./.logs"/>

    <!-- 로그 패턴 설정 -->
    <!-- {년}-{월}-{일} {시}:{분}:{초}:{밀리초} [{스레드명}] {로그 레벨} {로거 이름} - {메시지} -->
    <property name="LOG_PATTERN" value="%d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId} | %X{requestMethod} | %X{requestUrl}] - %msg%n"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 현재 기록 중인 파일명 -->
        <file>${LOG_PATH}/app.log</file>

        <!-- 일자별 롤링 정책 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 일자별로 압축 저장: app.2025-01-01.gz 형식 -->
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <!-- 30일간 보관 -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Root 로거 설정 -->
    <root>
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- 프로젝트 패키지 로그 레벨 제어: 분리하면 나중에 해당 로그만 다른 파일에 찍을 수 있게 변경도 가능함 -->
    <logger name="com.sprint.mission.discodeit" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- application.yml의 logging 설정을 따라감 -->

</configuration>