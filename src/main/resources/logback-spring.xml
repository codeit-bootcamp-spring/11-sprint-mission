<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!--콘솔 설정-->
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE">
    <!-- 로그 출력 예시 -->
    <!-- # 패턴 {년}-{월}-{일} {시}:{분}:{초}:{밀리초} [{스레드명}] {로그 레벨(5글자로 맞춤)} {로거 이름(최대 36글자)} - {로그 메시지}{줄바꿈}-->
    <!--# 예시 25-01-01 10:33:55.740 [main] DEBUG c.s.m.discodeit.DiscodeitApplication - Running with Spring Boot v3.4.0, Spring v6.2.0-->
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!--파일 설정-->
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FILE">
    <!-- 로그 출력 예시 -->
    <!-- # 패턴 {년}-{월}-{일} {시}:{분}:{초}:{밀리초} [{스레드명}] {로그 레벨(5글자로 맞춤)} {로거 이름(최대 36글자)} - {로그 메시지}{줄바꿈}-->
    <!--# 예시 25-01-01 10:33:55.740 [main] DEBUG c.s.m.discodeit.DiscodeitApplication - Running with Spring Boot v3.4.0, Spring v6.2.0-->
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} [%thread] %-5level %logger{36} [%X{requestId} |
        %X{method} | %X{url}] - %msg%n
      </pattern>
    </encoder>

    <!-- 경로는 {프로젝트 루트}/.logs-->
    <file>.logs/discodeit.log</file>

    <!-- 일자별로 롤링되고, 30일간 보관-->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>.logs/discodeit.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>

  <!--개발 환경-->
  <!-- 콘솔 뿐 아닌 파일에도 동시에 기록-->
  <springProfile name="dev">
    <logger level="DEBUG" name="com.sprint.mission"/>
    <root level="info">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </root>
  </springProfile>

  <!--운영 환경-->
  <!--파일만 기록, AWS 사용시에는 콘솔도 기록?-->
  <springProfile name="prod">
    <logger level="INFO" name="com.sprint.mission.discodeit"/>
    <root level="info">
      <appender-ref ref="FILE"/>
    </root>
  </springProfile>

</configuration>