# Spring 실행 profile 설정
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL 컨테이너 초기 DB 설정
POSTGRES_DB=discodeit
POSTGRES_USER=discodeit_user
POSTGRES_PASSWORD=change-me

# Spring Boot datasource 설정
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/discodeit
SPRING_DATASOURCE_USERNAME=discodeit_user
SPRING_DATASOURCE_PASSWORD=change-me

# BinaryContentStorage 로컬 저장소 설정
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=/app/.discodeit/storage

# JVM 실행 옵션
JVM_OPTS=